# Python virtual environment -- ~198MB, must never be committed.
# After cloning, each team member rebuilds it by following the setup
# steps in the README.
.venv/
venv/
env/

# Python bytecode cache
__pycache__/
*.py[cod]

# Auto-generated outputs (reproducible any time, don't belong in version control)
dataset/selftest_result.jpg
dataset/evaluation_result.csv
dataset/failures/
dataset/generated/

# Private assignment photographs. Keep only the empty folder structure in Git;
# raw images and any other local dataset content must not enter the public repo.
dataset/raw/**
!dataset/raw/**/
!dataset/raw/**/.gitkeep

# This labelled dataset is approved for inclusion in the repository.
!dataset/raw/tearing/**

# Local machine-specific config
.claude/settings.local.json

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
